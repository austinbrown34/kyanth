{
  "$name": "shout — Level",
  "$description": "Design tokens for the shout macOS redesign, Level concept. The brand layer is identical in both appearances because the app icon does not change appearance.",
  "$version": "1.0.0",

  "type": {
    "family": {
      "ui": "-apple-system, BlinkMacSystemFont, 'SF Pro Text', system-ui, sans-serif",
      "display": "-apple-system, BlinkMacSystemFont, 'SF Pro Display', system-ui, sans-serif",
      "mono": "ui-monospace, 'SF Mono', SFMono-Regular, Menlo, monospace"
    },
    "scale": {
      "wordmark":   { "size": 15.5, "weight": 600, "tracking": -0.022, "family": "display" },
      "windowTitle":{ "size": 13,   "weight": 590, "tracking": -0.005, "family": "ui" },
      "paneTitle":  { "size": 17,   "weight": 590, "tracking": -0.015, "family": "display" },
      "setupTitle": { "size": 19,   "weight": 590, "tracking": -0.015, "family": "display" },
      "body":       { "size": 12.5, "weight": 400, "tracking": 0,      "family": "ui" },
      "rowLabel":   { "size": 12.5, "weight": 550, "tracking": 0,      "family": "ui" },
      "note":       { "size": 11.5, "weight": 400, "tracking": 0.01,   "family": "ui" },
      "groupLabel": { "size": 9.5,  "weight": 600, "tracking": 0.11,   "family": "ui", "case": "upper" },
      "tableHead":  { "size": 9.5,  "weight": 600, "tracking": 0.11,   "family": "ui", "case": "upper" },
      "version":    { "size": 10.5, "weight": 400, "tracking": 0.02,   "family": "ui", "numeric": "tabular" }
    }
  },

  "radius": { "window": 11, "box": 9, "control": 6, "row": 7, "pill": 999 },

  "space": { "paneX": 22, "paneY": 18, "boxRowX": 14, "boxRowY": 11, "groupGap": 20, "sidebarGutter": 9 },

  "color": {
    "light": {
      "surface": "#ffffff",
      "footer": "#f7f7f9",
      "titlebar": "#f0f0f2",
      "border": "rgba(0,0,0,0.11)",
      "hover": "rgba(0,0,0,0.05)",
      "control": "#ffffff",
      "fg": "#1b1b1f",
      "muted": "#77777f",
      "accent": "#0a6cf5",
      "accentFg": "#ffffff",
      "record": "#e5372c",
      "warn": "#d4820a",
      "ok": "#1f9c4a",
      "meterIdle": "rgba(0,0,0,0.14)"
    },
    "dark": {
      "surface": "#232326",
      "footer": "#1e1e21",
      "titlebar": "#2c2c30",
      "border": "rgba(255,255,255,0.12)",
      "hover": "rgba(255,255,255,0.07)",
      "control": "rgba(255,255,255,0.09)",
      "fg": "#f0f0f2",
      "muted": "#96969e",
      "accent": "#3d8bff",
      "accentFg": "#ffffff",
      "record": "#ff5f52",
      "warn": "#f0a52a",
      "ok": "#3ec46d",
      "meterIdle": "rgba(255,255,255,0.16)"
    }
  },

  "brand": {
    "$note": "Lifted from the 1024 pt app icon. The band lifts slightly in dark mode; the logo gradients never change.",
    "band": {
      "light": { "angle": 152, "stops": ["#414a5e 0%", "#262c3a 54%", "#171b24 100%"] },
      "dark":  { "angle": 152, "stops": ["#333c4e 0%", "#1e2430 54%", "#12151c 100%"] },
      "sheen": "linear-gradient(180deg, rgba(255,255,255,0.13), rgba(255,255,255,0) 46%)",
      "fg": { "light": "#eef1f7", "dark": "#f0f2f7" },
      "muted": { "light": "rgba(238,241,247,0.58)", "dark": "rgba(240,242,247,0.56)" },
      "dim": { "light": "rgba(238,241,247,0.42)", "dark": "rgba(240,242,247,0.40)" }
    },
    "logo": {
      "barFill":  { "angle": 180, "stops": ["#ffffff 0%", "#cfd6e4 100%"] },
      "peakFill": { "angle": 180, "stops": ["#7db6ff 0%", "#0a6cf5 100%"] },
      "peakGlow": "0 0 12px rgba(125,182,255,0.5)",
      "proportions": { "$note": "bar heights, centred on one axis", "left": 34, "centre": 62, "right": 46 },
      "widthToGap": "4:3",
      "uiSize": { "height": 24, "barWidth": 6, "gap": 4.5, "radius": 3 }
    },
    "peak": {
      "solid": { "light": "#0a6cf5", "dark": "#3d8bff" },
      "gradient": { "light": ["#7db6ff", "#0a6cf5"], "dark": ["#8fc0ff", "#3d8bff"] }
    },
    "markDone": { "light": "#2c3444", "dark": "#46516a" },
    "silver": "#dfe4ee"
  },

  "rules": {
    "accentBudget": "At most 2 visible uses of the peak colour per screen. One is usually the selected sidebar row.",
    "greenReserved": "color.ok exists but is NOT used for satisfied setup steps — those use brand.markDone.",
    "logoVariants": "One size, one construction, one position (top-left). No small variant, no ghosted variant.",
    "appearance": "Everything flips except the brand layer."
  }
}
