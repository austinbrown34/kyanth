<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- A frozen Python app maps writable-executable pages and loads unsigned
       .so files at runtime; the hardened runtime blocks both without these.
       Notarization REQUIRES the hardened runtime, so they are not optional. -->
  <key>com.apple.security.cs.allow-jit</key>                            <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>     <true/>
  <key>com.apple.security.cs.disable-library-validation</key>           <true/>
  <!-- Microphone access under the hardened runtime -->
  <key>com.apple.security.device.audio-input</key>                      <true/>
</dict>
</plist>
